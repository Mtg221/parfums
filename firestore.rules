rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an authorized admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // Fallback for primary authenticated administrators
        request.auth.uid != null
      );
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Brands (Maisons de parfum) collection
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site photos collection
    match /site_photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection (Client orders & Admin management)
    match /orders/{orderId} {
      // Anyone can create an order with strict validation
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 6
                    && request.resource.data.address is string
                    && request.resource.data.address.size() >= 2
                    && request.resource.data.productId is string
                    && request.resource.data.quantity is number
                    && request.resource.data.quantity > 0;
                    
      // Strictly admins can read customer personal data, update status or delete
      allow read, update, delete: if isAdmin();
    }

    // Admins collection (Admin metadata & authorization)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
